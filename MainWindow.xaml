                                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="5,0,0,0">
                                <dxe:ToggleSwitch.Style>
                                    <Style TargetType="dxe:ToggleSwitch">
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Foreground" Value="#FF36C0F6"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter Property="Foreground" Value="#FFF68E36"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </dxe:ToggleSwitch.Style>
                            </dxe:ToggleSwitch>
                        </Grid>

