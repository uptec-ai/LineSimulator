                                <TextBlock Foreground="White" TextWrapping="Wrap">
                                    <Run Text="["/>
                                    <Run Text="{Binding MainWindowTimestampText, Mode=OneWay}"/>
                                    <Run Text="] ["/>
                                    <Run Text="{Binding LevelText, Mode=OneWay}"/>
                                    <Run Text="] "/>
                                    <Run Text="{Binding Message, Mode=OneWay}"/>
