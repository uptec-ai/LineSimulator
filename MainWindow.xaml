<Window x:Class="TestMcAlgorithm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:s="http://schemas.abtsoftware.co.uk/scichart"
        xmlns:local="clr-namespace:TestMcAlgorithm.Views"
        xmlns:converter="clr-namespace:TestMcAlgorithm.Converters"
        mc:Ignorable="d"
        Title="Line Simulator"
        Width="1920"
        Height="1020"
        MinWidth="1920"
        MinHeight="100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0F172A">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converter:ValueToBrushConverter x:Key="ValueToBrushConverter"/>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="#162033"/>
            <Setter Property="BorderBrush" Value="#26344D"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="StatusBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#FF0B1320"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="StatusLabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="/TestMcAlgorithm;component/Fonts/#Open 24 Display St"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="ContentStringFormat" Value="{}{0:F1}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ControlButtonStyle" TargetType="dx:SimpleButton">
            <Setter Property="GlyphWidth" Value="24"/>
            <Setter Property="GlyphHeight" Value="24"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,8,10,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#162033"/>
            <Setter Property="BorderBrush" Value="#26344D"/>
        </Style>

        <Style x:Key="KCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter Property="Background" Value="#0F9D58"/>
                    <Setter Property="BorderBrush" Value="#5DE2A5"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOn}" Value="True"/>
                        <Condition Binding="{Binding DisplayTargetBus}" Value="BUS1"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#0F9D58"/>
                    <Setter Property="BorderBrush" Value="#5DE2A5"/>

                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOn}" Value="True"/>
                        <Condition Binding="{Binding DisplayTargetBus}" Value="BUS2"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#B45309"/>
                    <Setter Property="BorderBrush" Value="#FCD34D"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOn}" Value="True"/>
                        <Condition Binding="{Binding DisplayTargetBus}" Value="BUS3"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#1D4ED8"/>
                    <Setter Property="BorderBrush" Value="#93C5FD"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BusComboStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="OvrDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#111827"/>
            <Setter Property="AlternatingRowBackground" Value="#1F2937"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
            <Setter Property="VerticalGridLinesBrush" Value="#334155"/>
        </Style>

        <Style x:Key="OvrDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="OvrDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#374151"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OvrDataGridTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Enable">
                    <Setter Property="Foreground" Value="Lime"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Idle">
                    <Setter Property="Foreground" Value="Orange"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OvrDataGridEditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style x:Key="OvrDataGridCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BusStatusStackPanelStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="250"/>
            <RowDefinition Height="580"/>
            <RowDefinition Height="170"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,0,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Column="0" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,10,0,0">
                    <Image Width="24" Height="24" Source="/Assets/64xLogo.ico"/>
                    <TextBlock Text="Line Simulator" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <TextBlock Text="{Binding State.Connection.IpAddress, StringFormat={} IP: {0}}" Foreground="#B8C2D6" VerticalAlignment="Center" Margin="18,8,0,0"/>
                    <TextBlock Text="{Binding State.Connection.Port, StringFormat={} Port: {0}}" Foreground="#B8C2D6" VerticalAlignment="Center" Margin="14,8,0,0"/>
                    <TextBlock Text="{Binding State.Connection.UnitId, StringFormat={} Unit ID: {0}}" Foreground="#B8C2D6" VerticalAlignment="Center" Margin="14,8,0,0"/>
                    <TextBlock Text="{Binding State.Connection.IsConnected, StringFormat={} Connected: {0}}" Foreground="White" VerticalAlignment="Center" Margin="18,8,0,0"/>
                </StackPanel>
                <!--<Setter Property="Background" Value="#162033"/>
                <Setter Property="BorderBrush" Value="#26344D"/>-->
                <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <dx:SimpleButton Glyph="{dx:DXImage 'SvgImages/Business Objects/BO_Category.svg'}" Style="{StaticResource ControlButtonStyle}" Command="{Binding ShowIpSettingsWindowCommand}"/>
                    <dx:SimpleButton Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Settings.svg'}" Style="{StaticResource ControlButtonStyle}" Command="{Binding ShowOcrSettingsWindowCommand}"/>
                    <dx:SimpleButton Glyph="{dx:DXImage 'SvgImages/PDF Viewer/SinglePageView.svg'}" Style="{StaticResource ControlButtonStyle}" Command="{Binding ShowLogWindowCommand}"/>
                    <dx:SimpleButton Glyph="{dx:DXImage 'SvgImages/RichEdit/DocumentStatistics.svg'}" Style="{StaticResource ControlButtonStyle}" Command="{Binding ShowLogWindowCommand}"/>
                </StackPanel>

                <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="BUS1" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Height="30"/>
                            <TextBlock Text="용량 (kVA)" Foreground="#94A3B8" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0" Height="30"/>
                            <TextBlock Text="SCR" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="18" Height="30" Margin="9,5,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <dx:SimpleButton Content="투입" Width="85" Height="30" Margin="22,0,0,0" Command="{Binding LineSimulator.Bus1ApplyCommand}"/>
                                <dx:SimpleButton Content="정지" Width="85" Height="30" Command="{Binding LineSimulator.Bus1OffCommand}" Margin="12,0,0,0"/>
                            </StackPanel>
                            <ComboBox Style="{StaticResource BusComboStyle}"
                                          IsEnabled="{Binding LineSimulator.CanEditBus1Settings}"
                                          ItemsSource="{Binding LineSimulator.Bus1RatedOptions}"
                                          SelectedItem="{Binding State.Bus1.RatedKva, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ItemStringFormat="{}{0:g}" Width="180" Margin="20,5,0,0" Height="30"/>
                            <ComboBox Style="{StaticResource BusComboStyle}"
                                          IsEnabled="{Binding LineSimulator.CanEditBus1Settings}"
                                          ItemsSource="{Binding LineSimulator.Bus1ScrOptions}"
                                          SelectedItem="{Binding State.Bus1.Scr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ItemStringFormat="{}{0:g}" Width="180" Margin="20,5,0,2" Height="30"/>
                        </StackPanel>

                        <TextBlock Grid.ColumnSpan="2" Text="{Binding State.Bus1.Summary}" Foreground="#E2E8F0" Margin="0,10,0,0" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                    </Grid>

                </Border>

                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="BUS2" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Height="30"/>
                            <TextBlock Text="용량 (kVA)" Foreground="#94A3B8" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0" Height="30"/>
                            <TextBlock Text="SCR" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="18" Height="30" Margin="9,5,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">

                                <dx:SimpleButton Content="투입" Width="85" Height="30" Margin="22,0,0,0" Command="{Binding LineSimulator.Bus2ApplyCommand}"/>
                                <dx:SimpleButton Content="정지" Width="85" Height="30" Command="{Binding LineSimulator.Bus2OffCommand}" Margin="12,0,0,0"/>
                            </StackPanel>
                            <ComboBox Style="{StaticResource BusComboStyle}"
                                      IsEnabled="{Binding LineSimulator.CanEditBus2Settings}"
                                      ItemsSource="{Binding LineSimulator.Bus2RatedOptions}"
                                      SelectedItem="{Binding State.Bus2.RatedKva, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemStringFormat="{}{0:g}" Width="180" Margin="20,5,0,0" Height="30"/>
                            <ComboBox Style="{StaticResource BusComboStyle}"
                                      IsEnabled="{Binding LineSimulator.CanEditBus2Settings}"
                                      ItemsSource="{Binding LineSimulator.Bus2ScrOptions}"
                                      SelectedItem="{Binding State.Bus2.Scr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemStringFormat="{}{0:g}" Width="180" Margin="20,5,0,2" Height="30"/>
                        </StackPanel>

                        <TextBlock Grid.ColumnSpan="2" Text="{Binding State.Bus2.Summary}" Foreground="#E2E8F0" Margin="0,10,0,0" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="BUS3" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Height="30"/>
                            <TextBlock Text="용량 (kVA)" Foreground="#94A3B8" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0" Height="30"/>
                            <TextBlock Text="SCR" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="18" Height="30" Margin="9,5,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">

                                <dx:SimpleButton Content="투입" Width="85" Height="30" Margin="22,0,0,0" Command="{Binding LineSimulator.Bus3ApplyCommand}"/>
                                <dx:SimpleButton Content="정지" Width="85" Height="30" Command="{Binding LineSimulator.Bus3OffCommand}" Margin="12,0,0,0"/>
                            </StackPanel>
                            <ComboBox Style="{StaticResource BusComboStyle}"
                                      IsEnabled="{Binding LineSimulator.CanEditBus3Settings}"
                                      ItemsSource="{Binding LineSimulator.Bus3RatedOptions}"
                                      SelectedItem="{Binding State.Bus3.RatedKva, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemStringFormat="{}{0:g}" Width="180" Margin="20,5,0,0" Height="30"/>
                            <ComboBox Style="{StaticResource BusComboStyle}"
                                      IsEnabled="{Binding LineSimulator.CanEditBus3Settings}"
                                      ItemsSource="{Binding LineSimulator.Bus3ScrOptions}"
                                      SelectedItem="{Binding State.Bus3.Scr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemStringFormat="{}{0:g}" Width="180" Margin="20,5,0,2" Height="30"/>
                        </StackPanel>

                        <TextBlock Grid.ColumnSpan="2" Text="{Binding State.Bus3.Summary}" Foreground="#E2E8F0" Margin="0,10,0,0" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Column="1" Grid.RowSpan="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"  Style="{StaticResource CardBorderStyle}" Padding="0">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Bus In" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Grid Grid.Row="1" Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource StatusBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="17"/>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#FF36C0F6" Margin="10,0,0,0"/>
                                        <TextBlock Text="전압" Grid.Column="1" FontSize="10" Foreground="LightGray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Label Content="{Binding LineSimulator.BusInMeter.AverageVoltageText}" Grid.Column="2" Style="{StaticResource StatusLabelStyle}" Margin="0,0,4,0"/>
                                        <TextBlock Text="V" Grid.Column="3" Foreground="#E2E8F0" Margin="0,3,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource StatusBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="17"/>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#FF36C0F6" Margin="10,0,0,0"/>
                                        <TextBlock Text="전류" Grid.Column="1" FontSize="10" Foreground="LightGray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Label Content="{Binding LineSimulator.BusInMeter.AverageCurrentText}" Grid.Column="2" Style="{StaticResource StatusLabelStyle}" Margin="0,0,4,0"/>
                                        <TextBlock Text="A" Grid.Column="3" Foreground="#E2E8F0" Margin="0,3,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" Style="{StaticResource StatusBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="17"/>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#FF36C0F6" Margin="10,0,0,0"/>
                                        <TextBlock Text="전력" Grid.Column="1" FontSize="10" Foreground="LightGray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Label Content="{Binding LineSimulator.BusInMeter.TotalActivePowerText}" Grid.Column="2" Style="{StaticResource StatusLabelStyle}" Margin="0,0,4,0"/>
                                        <TextBlock Text="kW" Grid.Column="3" Foreground="#E2E8F0" Margin="0,3,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="3" Style="{StaticResource StatusBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="17"/>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#FF36C0F6" Margin="10,0,0,0"/>
                                        <TextBlock Text="주파수" Grid.Column="1" FontSize="10" Foreground="LightGray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Label Content="{Binding LineSimulator.BusInMeter.FrequencyText}" Grid.Column="2" Style="{StaticResource StatusLabelStyle}" Margin="0,0,4,0"/>
                                        <TextBlock Text="hz" Grid.Column="3" Foreground="#E2E8F0" Margin="0,3,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"  Style="{StaticResource CardBorderStyle}" Padding="0">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Bus Out #1" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Grid Grid.Row="1" Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource StatusBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="17"/>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#FF36C0F6" Margin="10,0,0,0"/>
                                        <TextBlock Text="전류" Grid.Column="1" FontSize="10" Foreground="LightGray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Label Content="{Binding LineSimulator.BusOut1Meter.AverageCurrentText}" Grid.Column="2" Style="{StaticResource StatusLabelStyle}" Margin="0,0,4,0"/>
                                        <TextBlock Text="A" Grid.Column="3" Foreground="#E2E8F0" Margin="0,3,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource StatusBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="17"/>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#FF36C0F6" Margin="10,0,0,0"/>
                                        <TextBlock Text="전력" Grid.Column="1" FontSize="10" Foreground="LightGray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Label Content="{Binding LineSimulator.BusOut1Meter.TotalActivePowerText}" Grid.Column="2" Style="{StaticResource StatusLabelStyle}" Margin="0,0,4,0"/>
                                        <TextBlock Text="kW" Grid.Column="3" Foreground="#E2E8F0" Margin="0,3,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" Style="{StaticResource StatusBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="17"/>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#FF36C0F6" Margin="10,0,0,0"/>
                                        <TextBlock Text="부하율" TextWrapping="Wrap" Grid.Column="1" FontSize="10" Foreground="LightGray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Label Content="30.0" Grid.Column="2" Style="{StaticResource StatusLabelStyle}" Margin="0,0,4,0"/>
                                        <TextBlock Text="%" Grid.Column="3" Foreground="#E2E8F0" Margin="0,3,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="3" Style="{StaticResource StatusBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="17"/>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#FF36C0F6" Margin="10,0,0,0"/>
                                        <TextBlock Text="운전  상태" TextWrapping="Wrap" Grid.Column="1" FontSize="10" Foreground="LightGray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
