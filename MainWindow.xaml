                                  Margin="0,5,0,0"
                                  Style="{StaticResource OvrDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource OvrDataGridHeaderStyle}"
                                  CellStyle="{StaticResource OvrDataGridCellStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  ItemsSource="{Binding State.OvrSettings.Endpoints}"
                                  GridLinesVisibility="Horizontal"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  RowHeaderWidth="0">
