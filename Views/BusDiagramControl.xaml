<UserControl x:Class="TestMcAlgorithm.Views.BusDiagramControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TestMcAlgorithm.Views"
             xmlns:converters="clr-namespace:TestMcAlgorithm.Converters" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d" 
             d:DesignHeight="660" d:DesignWidth="2000">
    <UserControl.Resources>
        <converters:BusOutputStatusToBrushConverter x:Key="BusOutputStatusToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <LinearGradientBrush x:Key="TopLabelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F2F5F7" Offset="0"/>
            <GradientStop Color="#CBD3DA" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="TopLabelBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#F8FBFE"/>
            <Setter Property="Background" Value="{StaticResource TopLabelBrush}"/>
        </Style>

        <Style x:Key="DeviceBoxStyle" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#1A212B"/>
            <Setter Property="BorderBrush" Value="#AAB5C0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ContactDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Fill" Value="#F4F7FA"/>
        </Style>
    </UserControl.Resources>
    
    <Viewbox Stretch="Uniform">
        <Canvas Width="2000" Height="660" ClipToBounds="False">
            <ItemsControl Canvas.Left="0" Canvas.Top="0" Panel.ZIndex="3" ItemsSource="{Binding Outputs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas Width="160" Height="120">
                            <Border Style="{StaticResource TopLabelBorderStyle}"
                                    Tag="{Binding Title}"
                                    MouseLeftButtonUp="OutputBorder_MouseLeftButtonUp">
                                <Grid Margin="7,0">
                                    <TextBlock Text="{Binding Title}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontSize="14"
                                               Margin="-10,0,0,0"
                                               FontWeight="SemiBold"
                                               Foreground="#1F1F1F"/>
                                    <Ellipse Width="7"
                                             Height="7"
                                             Fill="{Binding IsOn, Converter={StaticResource BusOutputStatusToBrushConverter}}"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Line X1="75" Y1="32" X2="75" Y2="{Binding DropHeight}" Stroke="{Binding PathBrush}" StrokeThickness="1.2"/>
                            <Line X1="68" Y1="47" X2="82" Y2="35" Stroke="{Binding PathBrush}" StrokeThickness="1"/>
                            <Line X1="68" Y1="54" X2="82" Y2="42" Stroke="{Binding PathBrush}" StrokeThickness="1"/>
                            <Line X1="68" Y1="61" X2="82" Y2="49" Stroke="{Binding PathBrush}" StrokeThickness="1"/>
                            <Ellipse Style="{StaticResource ContactDotStyle}"
                                     Canvas.Left="72"
                                     Canvas.Top="{Binding ContactTop}"
                                     Fill="{Binding PathBrush}"/>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Canvas.Left="0" Canvas.Top="0" Panel.ZIndex="2" ItemsSource="{Binding Sections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="{Binding Width}" Height="500">
                            <Border Width="{Binding Width}"
                                    Height="500"
                                    Background="#0B1220"
                                    BorderBrush="#738498"
                                    BorderThickness="1.4"
                                    Opacity="1"/>

                            <Canvas Width="1400" Height="600">

                                <ItemsControl ItemsSource="{Binding OutRails}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="{Binding Width}"
                                                       Height="2"
                                                       Fill="#AAB5C0"
                                                       Opacity="0.82"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- BUS rail -->
                                <ItemsControl Canvas.Top="15" ItemsSource="{Binding Feeders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas Width="40"
                                                    Height="285"
                                                    Tag="{Binding Label}"
                                                    Background="Transparent"
                                                    MouseLeftButtonUp="FeederCanvas_MouseLeftButtonUp">
                                                <Ellipse Style="{StaticResource ContactDotStyle}"
                                                         Canvas.Left="17.25"
                                                         Canvas.Top="{Binding ContactTop}"
                                                         Fill="{Binding PathBrush}"/>
                                                <Line X1="20"
                                                      Y1="{Binding ConnectionY}"
                                                      X2="20"
                                                      Y2="79"
                                                      Stroke="{Binding PathBrush}"
                                                      StrokeThickness="1.2"/>

                                                <!-- K module box -->
                                                <Border Canvas.Left="4"
                                                        Canvas.Top="79"
                                                        Width="32"
                                                        Height="44"
                                                        Background="#1A212B"
                                                        BorderBrush="#AAB5C0"
                                                        BorderThickness="1"/>

                                                <Canvas Canvas.Left="4" Canvas.Top="79" Width="32" Height="44">
                                                    <Line X1="8" Y1="10" X2="8" Y2="32" Stroke="#D7E0E8" StrokeThickness="1"/>
                                                    <Line X1="8" Y1="30" X2="23" Y2="12" Stroke="#D7E0E8" StrokeThickness="1.2"/>
                                                    <Line X1="23" Y1="12" X2="23" Y2="33" Stroke="#D7E0E8" StrokeThickness="1"/>
                                                    <Ellipse Width="3.5" Height="3.5" Fill="#D7E0E8" Canvas.Left="21.25" Canvas.Top="31.5"/>
                                                </Canvas>

                                                <TextBlock Canvas.Left="7"
                                                   Canvas.Top="125"
                                                   Width="26"
                                                   HorizontalAlignment="Center"
                                                   Text="{Binding Label}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   Foreground="#E2E8F0"/>

                                                <Line X1="20" Y1="145" X2="20" Y2="167" Stroke="{Binding PathBrush}" StrokeThickness="1.1"/>

                                                <!-- L -->
                                                <Border Style="{StaticResource DeviceBoxStyle}" Canvas.Left="5" Canvas.Top="167"/>
                                                <Canvas Canvas.Left="5" Canvas.Top="167" Width="30" Height="46">
                                                    <Path Stroke="#D7E0E8"
                                                  StrokeThickness="1.2"
                                                  Data="M 16 8 C 10 10, 10 16, 16 18 C 10 20, 10 26, 16 28 C 10 30, 10 36, 16 38"/>
                                                </Canvas>

                                                <Line X1="20" Y1="213" X2="20" Y2="227" Stroke="{Binding PathBrush}" StrokeThickness="1.1"/>

                                                <!-- R -->
                                                <Border Style="{StaticResource DeviceBoxStyle}" Canvas.Left="5" Canvas.Top="227" Height="40"/>
                                                <Canvas Canvas.Left="5" Canvas.Top="227" Width="30" Height="40">
                                                    <Polyline Stroke="#D7E0E8"
                                                      StrokeThickness="1.2"
                                                      Points="14,5 18,10 12,15 18,20 12,25 18,30 14,35"/>
                                                </Canvas>

                                                <Line X1="20" Y1="267" X2="20" Y2="300" Stroke="{Binding PathBrush}" StrokeThickness="1.2"/>

                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- MC Marker -->
                                <ItemsControl Canvas.Top="0" Panel.ZIndex="4" ItemsSource="{Binding McMarkers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="100"
                                                        Background="Transparent"
                                                        Tag="{Binding DeviceName}"
                                                        MouseLeftButtonUp="MarkerStackPanel_MouseLeftButtonUp">
                                                <Image Source="/Assets/Icon_128x128.png"
                                                       Width="30"
                                                       Height="30"
                                                       HorizontalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Label}"
                                                           Margin="0,2,0,0"
                                                           HorizontalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#E2E8F0"/>
                                                <TextBlock Margin="0,2,0,0"
                                                           HorizontalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding CurrentBrush}"
                                                           Text="{Binding CurrentText}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- BUS tap -->
                                <ItemsControl ItemsSource="{Binding BusTaps}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas Width="14" Height="58">
                                                <Line X1="45"
                                                      Y1="0"
                                                      X2="45"
                                                      Y2="{Binding ConnectionY}"
                                                      Stroke="{Binding PathBrush}"
                                                      StrokeThickness="1.2"/>
                                                <Ellipse Style="{StaticResource ContactDotStyle}"
                                                         Canvas.Left="42"
                                                         Canvas.Top="{Binding ContactTop}"
                                                         Fill="{Binding PathBrush}"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- In Rail -->
                                <ItemsControl ItemsSource="{Binding InRails}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="{Binding Width}"
                                               Height="2"
                                               Fill="#AAB5C0"
                                               Opacity="0.82"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Line X1="{Binding InputStemX}"
                                      X2="{Binding InputStemX}"
                                      Y1="{Binding InputStemY}"
                                      Y2="{Binding InputArriveY}"
                                      Stroke="{Binding InputStemBrush}"
                                      StrokeThickness="2"/>

                                <ItemsControl ItemsSource="{Binding HighlightSegments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Line X1="{Binding X1}"
                                                  Y1="{Binding Y1}"
                                                  X2="{Binding X2}"
                                                  Y2="{Binding Y2}"
                                                  Stroke="{Binding Stroke}"
                                                  StrokeThickness="{Binding Thickness}"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>

                            <StackPanel Margin="{Binding Margin}"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentLabel}"
                                               HorizontalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#E5E7EB"/>
                                    <Border Width="40"
                                            Height="40"
                                            Margin="0,5"
                                            Background="#1A212B"
                                            BorderBrush="#AAB5C0"
                                            BorderThickness="1">
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Row="0" Grid.Column="0" Margin="1" BorderBrush="#D7E0E8" BorderThickness="1"/>
                                            <Border Grid.Row="0" Grid.Column="1" Margin="1" BorderBrush="#D7E0E8" BorderThickness="1"/>
                                            <Border Grid.Row="1" Grid.Column="0" Margin="1" BorderBrush="#D7E0E8" BorderThickness="1"/>
                                            <Border Grid.Row="1" Grid.Column="1" Margin="1" BorderBrush="#D7E0E8" BorderThickness="1"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding InputLabel}"
                                               HorizontalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#F3F4F6"/>
                                </StackPanel>

                                <StackPanel Width="52"
                                            Margin="10,23,0,0"
                                            Visibility="{Binding ShowMcMarker, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            HorizontalAlignment="Center"
                                            Background="Transparent"
                                            Tag="{Binding PmMarker.DeviceName}"
                                            MouseLeftButtonUp="MarkerStackPanel_MouseLeftButtonUp">
                                    <Image Source="/Assets/Icon_128x128.png"
                                           Width="30"
                                           Height="30"
                                           HorizontalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding PmMarker.Label}"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#E2E8F0"/>
                                    <TextBlock Margin="0,2,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PmMarker.CurrentBrush}"
                                               Text="{Binding PmMarker.CurrentText}"/>
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </Viewbox>
</UserControl>
