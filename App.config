<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Modbus 모니터링 서버 바인딩 주소 (앱 시작 시 자동 오픈). 기본 127.0.0.1:7000 -->
    <add key="MonitoringServerHost" value="127.0.0.1" />
    <add key="MonitoringServerPort" value="7000" />

    <!-- OVR/OCR 엔드포인트 (IP + Modbus 포트, 기본 포트 502) -->
    <add key="OCR1_Ip" value="192.168.1.10" />
    <add key="OCR1_Port" value="502" />
    <add key="OCR2_Ip" value="192.168.1.11" />
    <add key="OCR2_Port" value="502" />
    <add key="OCR3_Ip" value="192.168.1.12" />
    <add key="OCR3_Port" value="502" />
    <add key="OCR4_Ip" value="192.168.1.13" />
    <add key="OCR4_Port" value="502" />
    <add key="OCR5_Ip" value="192.168.1.14" />
    <add key="OCR5_Port" value="502" />
    <add key="OCR6_Ip" value="192.168.1.15" />
    <add key="OCR6_Port" value="502" />
    <add key="OCR7_Ip" value="192.168.1.16" />
    <add key="OCR7_Port" value="502" />
    <add key="OCR8_Ip" value="192.168.1.17" />
    <add key="OCR8_Port" value="502" />
    <add key="OCR9_Ip" value="192.168.1.18" />
    <add key="OCR9_Port" value="502" />
    <add key="OCR10_Ip" value="192.168.1.19" />
    <add key="OCR10_Port" value="502" />

    <!-- 전력미터 엔드포인트 (PM1=bus in, PM2=bus out1, PM3=bus out2, PM4=bus out3) -->
    <add key="PM1_Ip" value="192.168.1.20" />
    <add key="PM1_Port" value="502" />
    <add key="PM2_Ip" value="192.168.1.21" />
    <add key="PM2_Port" value="502" />
    <add key="PM3_Ip" value="192.168.1.22" />
    <add key="PM3_Port" value="502" />
    <add key="PM4_Ip" value="192.168.1.23" />
    <add key="PM4_Port" value="502" />
  </appSettings>
</configuration>
